---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import AdSlot from '../components/AdSlot.astro';
import SeriesCover from '../components/SeriesCover.astro';
import { posts, seriesGroups, seriesName, postUrl, dateLabel } from '../lib/posts';
const all = await posts(); const groups=seriesGroups(all); const featured=all.find(p=>p.data.series==='claude-code') || all[0];
const categories=[...new Set(all.flatMap(p=>p.data.categories))];
---
<Base>
<section class="hero shell">
  <div class="hero-copy"><div class="eyebrow"><span class="live-dot"></span>개발하며 남기는 생각과 경험</div><h1>만들고, 부딪히고,<br/><span class="hero-last">다시 생각합니다<span class="accent">.</span></span></h1><p>완벽한 정답보다, 그 답을 찾아가는 과정.<br/>직접 만든 프로젝트와 시행착오, 그 안에서 배운 것들을 기록합니다.</p><div class="hero-links"><a class="text-link" href="/about/">이 블로그에 대하여 <span>↗</span></a><span class="hero-since">기록 중 · 2019 — {new Date().getFullYear()}</span></div></div>
  <a class="featured-note" href={postUrl(featured)}><div class="note-top"><span>다시 읽는 기록</span><span>↗</span></div><SeriesCover id={featured.data.series || 'claude-code'} /><div class="note-content"><span class="eyebrow">{featured.data.series ? seriesName(featured.data.series) : '개발 일기'}</span><h2>{featured.data.title}</h2><span class="note-date">{dateLabel(featured.data.date)} <span>읽어보기 →</span></span></div></a>
</section>
<section class="series-strip shell"><div class="section-kicker"><span class="eyebrow">하나의 경험, 이어지는 이야기</span><a href="/series/">시리즈 모아보기 ↗</a></div><div class="series-mini-grid">{groups.slice(0,3).map(g=><a class="series-mini" href={`/series/${g.id}/`}><span class="mini-cover"><SeriesCover id={g.id}/></span><div><h3>{g.name}</h3><p>{g.items.length}개의 기록 <span>·</span> {dateLabel(g.items.at(-1)!.data.date)}</p></div><span class="mini-arrow">→</span></a>)}</div></section>
<div class="content-grid shell"><section class="latest-section"><div class="section-heading"><div><span class="eyebrow">THE JOURNAL</span><h2>최근 기록<span class="count">{all.length}</span></h2></div><a class="subtle-link" href="/archive/">모든 글 보기 ↗</a></div><div class="topic-tabs"><a class="active" href="/archive/">전체 기록</a>{categories.slice(0,4).map(c=><a href={`/archive/?category=${encodeURIComponent(c)}`}>{c}</a>)}</div><div>{all.slice(0,8).map((post,i)=><PostRow post={post} index={i}/>)}</div><a href="/archive/" class="more-link">지난 기록 더 읽어보기 <span>↓</span></a></section><aside class="journal-sidebar"><section class="author-note"><div class="author-heading"><img src="/assets/images/avata.png" alt="Seungwoo321 프로필" width="44" height="44"/><div><strong>Seungwoo321</strong><span>프론트엔드 개발자</span></div></div><h3>경험이 쌓이면,<br/>이야기가 됩니다.</h3><p>사이드 프로젝트, 오픈소스, 그리고 AI와 함께 일하는 방식. 직접 해보며 알게 된 것들을 나눕니다.</p><a href="/about/" class="text-link">조금 더 알아보기 ↗</a><div class="author-bottom"><span class="live-dot"></span>서울에서 만들고 기록합니다</div></section><section class="sidebar-topics"><span class="eyebrow">기록의 갈래</span>{categories.slice(0,7).map(c=><a href={`/archive/?category=${encodeURIComponent(c)}`}><span>{c}</span><span>{all.filter(p=>p.data.categories.includes(c)).length.toString().padStart(2,'0')}</span></a>)}</section><AdSlot/><a class="rss-link" href="/feed.xml"><span>◔</span><div><strong>새로운 기록 받아보기</strong><span>RSS로 천천히, 꾸준히.</span></div><span>↗</span></a></aside></div>
</Base>

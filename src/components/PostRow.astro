---
import { postUrl, summary, dateLabel, readMinutes, type Post } from '../lib/posts';
const { post, index = 0 } = Astro.props as { post: Post; index?: number };
---
<article class="post-row">
  <span class="post-number" aria-hidden="true">{String(index + 1).padStart(2,'0')}</span>
  <div class="post-row-main">
    <div class="eyebrow post-category">{post.data.categories[0] || '개발 기록'}</div>
    <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
    <p>{summary(post)}</p>
    <div class="post-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>·</span><span>{readMinutes(post)}분 읽기</span>{post.data.tags.slice(0,2).map(tag => <span class="meta-tag">#{tag}</span>)}</div>
  </div>
  <a class="row-arrow" href={postUrl(post)} aria-label={`${post.data.title} 읽기`}>↗</a>
</article>

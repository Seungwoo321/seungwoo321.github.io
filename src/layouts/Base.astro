---
import '../styles/global.css';
import { posts, postUrl, summary } from '../lib/posts';
const { title = 'DEV LOG — 시도하고, 만들고, 기록합니다', description = 'Seungwoo321의 개발 일기. 직접 만들며 겪은 시행착오와 기술 선택의 과정을 기록합니다.' } = Astro.props;
const all = await posts();
const searchIndex = all.map(p => ({title:p.data.title,url:postUrl(p),summary:summary(p),tags:p.data.tags.join(' ')}));
const path = Astro.url.pathname;
const canonical = new URL(path.replace(/\.html\/$/, '.html'), Astro.site);
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <meta name="google-site-verification" content="px1TntEZ-EKoV9k9xHvbO7KsQMLwj_Ajab5nprTM_pM" />
  <meta name="google-adsense-account" content="ca-pub-7701657858733816" />
  <link rel="apple-touch-icon" href="/assets/favicons/apple-icon-180x180.png" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#fcfcfd" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="alternate" type="application/rss+xml" title="DEV LOG" href="/feed.xml" />
  <script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('devlog-theme')||'light'}catch{}</script>
  {import.meta.env.PROD && <script is:inline>
    if (location.hostname === 'seungwoo321.github.io') {
      const ads = document.createElement('script');
      ads.async = true;
      ads.crossOrigin = 'anonymous';
      ads.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7701657858733816';
      document.head.appendChild(ads);
      const analytics = document.createElement('script');
      analytics.async = true;
      analytics.src = 'https://www.googletagmanager.com/gtag/js?id=G-H6MFMXFRLY';
      document.head.appendChild(analytics);
      window.dataLayer = window.dataLayer || [];
      function gtag(){ window.dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-H6MFMXFRLY');
    }
  </script>}
</head>
<body>
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>
  <header class="site-header"><div class="shell header-inner">
    <a href="/" class="brand" aria-label="DEV LOG 홈"><span class="brand-mark">d<span>.</span></span><span>DEV LOG<span class="brand-by">by Seungwoo321</span></span></a>
    <nav class="main-nav" aria-label="주 메뉴">{[['/','글'],['/series/','시리즈'],['/projects/','프로젝트'],['/about/','소개']].map(([href,label]) => <a href={href} aria-current={(href === '/' ? path === '/' || path.startsWith('/blog/') : path.startsWith(href)) ? 'page' : undefined}>{label}</a>)}</nav>
    <div class="header-actions"><button class="icon-button search-open" aria-label="글 검색"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><kbd>/</kbd></button><span class="action-divider"></span><button class="icon-button theme-toggle" aria-label="어두운 테마로 변경" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.8 14.1A9 9 0 0 1 9.9 3.2 9 9 0 1 0 20.8 14.1Z"/></svg></button></div>
  </div></header>
  <main id="main"><slot /></main>
  <footer class="site-footer shell"><a class="footer-brand" href="/">DEV LOG<span class="accent">.</span></a><p>만들며 배운 것들을, 오래 남을 기록으로.</p><div><a href="https://github.com/Seungwoo321" target="_blank" rel="noreferrer">GitHub ↗</a><a href="/feed.xml">RSS ↗</a><span>© {new Date().getFullYear()} Seungwoo321</span></div></footer>
  <dialog class="search-dialog" aria-labelledby="search-title"><div class="search-dialog-head"><h2 id="search-title">기록 검색</h2><button class="search-close icon-button" aria-label="검색 닫기">✕</button></div><label class="search-input-wrap"><span class="sr-only">검색어</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><input id="search-input" type="search" placeholder="궁금한 기술이나 경험을 찾아보세요" autocomplete="off" /></label><p class="search-status" aria-live="polite">제목·태그·글 소개에서 검색합니다.</p><ul class="search-results"></ul><div class="search-footer">ESC 닫기 <span>{all.length}개의 기록</span></div></dialog>
  <script type="application/json" id="search-data" set:html={JSON.stringify(searchIndex).replace(/</g,'\u003c')} />
  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
    function syncTheme(){ const dark=document.documentElement.dataset.theme==='dark'; toggle.setAttribute('aria-pressed',String(dark)); toggle.setAttribute('aria-label',dark?'밝은 테마로 변경':'어두운 테마로 변경'); }
    syncTheme(); toggle.addEventListener('click',()=>{document.documentElement.dataset.theme=document.documentElement.dataset.theme==='dark'?'light':'dark';try{localStorage.setItem('devlog-theme',document.documentElement.dataset.theme)}catch{}syncTheme()});
    const dialog=document.querySelector<HTMLDialogElement>('.search-dialog')!;
    const input=document.querySelector<HTMLInputElement>('#search-input')!;
    const results=document.querySelector<HTMLUListElement>('.search-results')!;
    const status=document.querySelector<HTMLParagraphElement>('.search-status')!;
    const data: {title:string;url:string;summary:string;tags:string}[]=JSON.parse(document.querySelector('#search-data')!.textContent!);
    function search(){const q=input.value.trim().toLocaleLowerCase();results.replaceChildren();if(!q){status.textContent='제목·태그·글 소개에서 검색합니다.';return}const found=data.filter(p=>`${p.title} ${p.summary} ${p.tags}`.toLocaleLowerCase().includes(q));status.textContent=found.length?`${found.length}개의 기록을 찾았습니다.`:'검색 결과가 없습니다. 다른 검색어로 찾아보세요.';for(const p of found.slice(0,20)){const li=document.createElement('li');const a=document.createElement('a');a.href=p.url;const title=document.createElement('strong');title.textContent=p.title;const desc=document.createElement('span');desc.textContent=p.summary.slice(0,85);a.append(title,desc);li.append(a);results.append(li)}}
    document.querySelectorAll('.search-open').forEach(b=>b.addEventListener('click',()=>{dialog.showModal();input.focus()}));
    document.querySelector('.search-close')!.addEventListener('click',()=>dialog.close());
    dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close()}});
    input.addEventListener('input',search);document.addEventListener('keydown',e=>{if(e.key==='Escape'&&dialog.open){e.preventDefault();dialog.close();return}if((e.key==='/'||((e.metaKey||e.ctrlKey)&&e.key==='k')) && !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement)){e.preventDefault();if(!dialog.open){dialog.showModal();input.focus()}}});
  </script>
</body></html>
